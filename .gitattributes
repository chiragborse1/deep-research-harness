* text=auto eol=lf

# Keep binary assets binary.
*.png binary
*.jpg binary
*.gif binary
*.whl binary
*.sqlite binary
*.db binary

# Windows scripts need CRLF to run from cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Lockfiles and generated fixtures are checked in verbatim.
uv.lock text eol=lf -diff
